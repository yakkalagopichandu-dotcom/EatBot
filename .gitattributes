# Normalize line endings to LF in the repo; check out as-is on Windows
* text=auto

# Kotlin / Java / XML → always LF
*.kt    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.kts   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.properties text eol=lf

# Windows batch files → CRLF
*.bat   text eol=crlf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.mp4   binary
*.avi   binary
*.apk   binary
*.so    binary
*.aar   binary
